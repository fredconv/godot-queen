; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dame de pique"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[internationalization]

locale/translations=PackedStringArray("res://translations/common.fr.translation", "res://translations/common.en.translation", "res://translations/common.de.translation", "res://translations/common.es.translation", "res://translations/common.pt.translation", "res://translations/common.zh.translation", "res://translations/menu.fr.translation", "res://translations/menu.en.translation", "res://translations/menu.de.translation", "res://translations/menu.es.translation", "res://translations/menu.pt.translation", "res://translations/menu.zh.translation", "res://translations/table.fr.translation", "res://translations/table.en.translation", "res://translations/table.de.translation", "res://translations/table.es.translation", "res://translations/table.pt.translation", "res://translations/table.zh.translation", "res://translations/dialogs.fr.translation", "res://translations/dialogs.en.translation", "res://translations/dialogs.de.translation", "res://translations/dialogs.es.translation", "res://translations/dialogs.pt.translation", "res://translations/dialogs.zh.translation", "res://translations/game.fr.translation", "res://translations/game.en.translation", "res://translations/game.de.translation", "res://translations/game.es.translation", "res://translations/game.pt.translation", "res://translations/game.zh.translation")
locale/fallback="fr"

[autoload]

GameEvents="*res://scripts/services/game_events.gd"
SaveService="*res://scripts/services/save_service.gd"
PlayerProfileService="*res://scripts/services/player_profile_service.gd"
ConfigService="*res://scripts/services/config_service.gd"
StatsService="*res://scripts/services/stats_service.gd"
AudioService="*res://scripts/services/audio_service.gd"
DebugService="*res://scripts/services/debug_service.gd"
GameSession="*res://scripts/services/game_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="C:/Projects/Godot/EXPORT TESTABLE/queen_movie_01.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gui]

timings/tooltip_delay_sec=0.2

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

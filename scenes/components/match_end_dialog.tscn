[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/components/match_end_dialog.gd" id="1_match_end"]
[ext_resource type="PackedScene" path="res://scenes/components/player_avatar.tscn" id="2_avatar"]

; Voile sombre + panneau à bordure or : même style que `confirm_dialog.tscn`
; (voir docs/DECISIONS.md ADR-017) pour rester cohérent avec le reste du chrome UI.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_backdrop"]
bg_color = Color(0, 0, 0, 0.6)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.129, 0.129, 0.157, 0.98)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.831, 0.686, 0.216, 1)
content_margin_left = 32.0
content_margin_top = 24.0
content_margin_right = 32.0
content_margin_bottom = 24.0

[node name="MatchEndDialog" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 1
visible = false
script = ExtResource("1_match_end")

[node name="Backdrop" type="Panel" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_styles/panel = SubResource("StyleBoxFlat_backdrop")

; Flèches pointant vers le siège du vainqueur (une seule visible à la fois,
; voir `match_end_dialog.gd::show_result`). Position calée sur les sièges de
; `table.tscn` (SeatTop/SeatBottom/SeatLeft/SeatRight).
[node name="ArrowTop" type="Label" parent="."]
anchor_left = 0.5
anchor_right = 0.5
offset_left = -30.0
offset_top = 186.0
offset_right = 30.0
offset_bottom = 236.0
theme_override_colors/font_color = Color(0.831, 0.686, 0.216, 1)
theme_override_font_sizes/font_size = 42
horizontal_alignment = 1
vertical_alignment = 1
text = "▲"

[node name="ArrowBottom" type="Label" parent="."]
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0

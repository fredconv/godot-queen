; Couche dédiée aux cartes en cours d'animation (glissement main/siège -> pli,
; ramassage du pli vers le siège du vainqueur) : dernier enfant du layer de
; jeu (layer 0 implicite) pour se dessiner par-dessus sièges/pli/main pendant
; le vol de la carte, tout en restant sous `UILayer` (layer 10).
[node name="AnimationLayer" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; CanvasLayer dédié au chrome UI (barre de menu + dialogue de confirmation) :
; garantit qu'il se dessine toujours au-dessus du reste de la table (fond,
; sièges, plis, main) quel que soit l'ordre des autres nœuds, y compris à
; l'export (voir docs/DECISIONS.md ADR-015).
[node name="UILayer" type="CanvasLayer" parent="."]
layer = 10


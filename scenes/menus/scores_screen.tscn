[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/scores_screen.gd" id="1_scores"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_backdrop"]
bg_color = Color(0, 0, 0, 0.6)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
bg_color = Color(0.129, 0.129, 0.157, 0.98)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.831, 0.686, 0.216, 1)
content_margin_left = 24.0
content_margin_top = 20.0
content_margin_right = 24.0
content_margin_bottom = 20.0

[node name="ScoresScreen" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 1
visible = false
script = ExtResource("1_scores")

[node name="Backdrop" type="Panel" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_styles/panel = SubResource("StyleBoxFlat_backdrop")

[node name="Panel" type="PanelContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -240.0
offset_top = -160.0
offset_right = 240.0
offset_bottom = 160.0
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Panel/Margin/VBox"]
theme_override_colors/font_color = Color(0.831, 0.686, 0.216, 1)
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
text = "Statistiques"

[node name="EmptyLabel" type="Label" parent="Panel/Margin/VBox"]
horizontal_alignment = 1
autowrap_mode = 2
text = "Aucune partie terminée pour l'instant.\nLancez une nouvelle partie pour commencer votre historique."

[node name="SummaryLabel" type="Label" parent="Panel/Margin/VBox"]
visible = false
autowrap_mode = 2
text = "Parties terminées : 0"

[node name="BtnBack" type="Button" parent="Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 44)
text = "RETOUR"

[connection signal="pressed" from="Panel/Margin/VBox/BtnBack" to="." method="_on_btn_back_pressed"]

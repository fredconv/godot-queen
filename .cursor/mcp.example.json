{
  "mcpServers": {
    "godot": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@coding-solo/godot-mcp"
      ],
      "env": {
        "GODOT_PATH": "C:\\path\\to\\Godot_v4.7-stable_win64.exe",
        "DEBUG": "false"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_CTX7_API_KEY"
      }
    }
  }
}

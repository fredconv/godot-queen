[gd_resource type="Theme" load_steps=2 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/PixelifySans-VariableFont_wght.ttf" id="1_font"]

; Thème pixel art (voir docs/DECISIONS.md ADR-008/ADR-009 et docs/TECHNICAL_DESIGN.md
; section "Direction artistique UI — pixel art").
; Point d'ancrage unique pour les StyleBox de boutons/panneaux à bords nets, la
; police pixel et les couleurs de la palette proposée, au fur et à mesure de
; l'intégration des assets pixel art réels.
;
; default_font : police "Pixelify Sans" appliquée par défaut à tous les Label/
; Button des scènes qui héritent de ce thème (ex. Table, TopMenuBar). Taille de
; police non surchargée (garde la taille par défaut du moteur) pour ne pas
; perturber les mises en page existantes (voir ADR-009).

[resource]
default_font = ExtResource("1_font")
